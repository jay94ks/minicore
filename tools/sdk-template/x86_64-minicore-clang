#!/usr/bin/env bash
# minicore SDK 컴파일러 래퍼 (real-libc-syscall-layer.md §M38,
# docs/design/build-system.md ADR-190). 이미 설치된 크로스 clang에
# 이 SDK의 include 경로+타깃 트리플을 자동으로 얹는다 — "sysroot만
# minicore 것으로 바꾼 표준 트리플"이라는 크로스 SDK 흔한 패턴을
# 그대로 따르되, 실제 타깃 트리플은 ADR-190 원안(x86_64-linux-musl)
# 이 아니라 **x86_64-unknown-none-elf**로 확정했다(M38 실행 중
# 범위 조정) — minicore 저장소 안의 libc.a 자신이 실제로 이
# 트리플로 컴파일됐다(toolchain/x86_64-clang.cmake, ADR-020). 다른
# 트리플로 이 SDK의 헤더/라이브러리를 컴파일하는 조합은 한 번도
# 검증된 적이 없어, 검증된 조합을 그대로 유지한다.
#
# 컴파일(-c)에만 쓴다 — 최종 링크는 clang을 드라이버로 쓰지 않고
# ld.lld를 직접 부른다(저장소 안 userland/*/CMakeLists.txt와 같은
# 이유: clang의 링크 모드는 자기 자신의 기본 crt/libc 탐색을
# 가정해서, 이 SDK의 정적 libc.a+커스텀 link.ld 조합과 맞지 않는다).
#
# **셸에서 사람이 직접 부르는 용도**(또는 셸을 거치는 Makefile 등)
# 다 — CMake가 CMAKE_C_COMPILER로 이 스크립트를 직접 실행하지는
# 않는다(cmake/ninja는 컴파일러를 OS 프로세스 실행기로 직접
# 실행해서, Windows에서는 bash 스크립트를 그렇게 실행할 수 없다 —
# M38 실행 중 실제로 겪음, "%1 is not a valid Win32 application").
# x86_64-minicore.cmake는 대신 이 스크립트와 같은 플래그를 직접
# 주입해 clang을 그대로 부른다 — 이 스크립트는 그 플래그들을 한
# 곳에서 사람이 읽기 쉽게 보여주는 참고 자료이자, CMake를 안 쓰는
# 사용자를 위한 진입점이다.
set -euo pipefail

SDK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

exec clang \
  --target=x86_64-unknown-none-elf \
  -ffreestanding \
  -fno-stack-protector \
  -mno-red-zone \
  -mno-mmx \
  -mno-sse \
  -mno-sse2 \
  -mno-3dnow \
  -I"$SDK_ROOT/include/musl/arch/x86_64" \
  -I"$SDK_ROOT/include/musl/arch/generic" \
  -I"$SDK_ROOT/include/musl/generated" \
  -I"$SDK_ROOT/include/musl/include" \
  -I"$SDK_ROOT/include" \
  "$@"
